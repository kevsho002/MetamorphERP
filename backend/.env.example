# Copiar a .env y ajustar. Nunca versionar .env
APP_ENV=development
# Obligatoria en producción (cadena larga y aleatoria):
# DJANGO_SECRET_KEY=
# DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Orígenes que pueden enviar POST con cookie (Vite en desarrollo)
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- SQL Server ---
DB_SERVER=localhost
# DB_PORT=1433
DB_NAME=MetamorphERP
DB_DRIVER=ODBC Driver 18 for SQL Server
# true = autenticación Windows; false = usar DB_USER/DB_PASSWORD
DB_TRUSTED_CONNECTION=true
# DB_USER=metamorph_app
# DB_PASSWORD=
DB_ENCRYPT=true
# Solo desarrollo (certificado autofirmado). En producción: false
DB_TRUST_SERVER_CERTIFICATE=true

# --- Seguridad ---
# Duración de la sesión en segundos (8 h)
SESSION_COOKIE_AGE=28800
LOGIN_THROTTLE_RATE=10/min

# Expediente digital (Fase 5): carpeta privada de imágenes (relativa a backend/ o absoluta)
PRIVATE_MEDIA_ROOT=private_media
